# Kopia av de värden appen läser. Kopiera till .env.local och fyll i.
# .env.local läses aldrig in av Lovable och ligger inte i Git – den är bara för
# din lokala utvecklingsmaskin.
#
# Värdena som redan står i .env (SUPABASE_ och VITE__) följer med i repot och
# behöver inte upprepas här.

# ---- Logga in med din vanliga PIN ----
# Hemlig "peppar" som PIN-koden blandas ihop med. Måste vara exakt samma värde
# som i Lovable för att din befintliga PIN ska fungera lokalt.
# Utan detta värde kan du bara logga in med ett konto du skapar lokalt.
PIN_PEPPER=

# ---- Push-notiser från din lokala körning ----
# Nyckelparet som signar notiserna. Samma par som i Lovable.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notiser@dagsform.app

# ---- Påminnelsejobbet ----
# Hemlig nyckan som påminnelseendpointen kontrollerar.
REMINDER_CRON_SECRET=

# ---- Adress appen själv når sig på ----
# Används för länkar i notiser. Lokalt: http://localhost:5173
APP_URL=

# ---- Behövs bara om du kör på egen server ----
# Nyckeln med högst behörighet. Finns INTE att hämta från Lovable, så
# kontoskapande och PIN-byte fungerar inte lokalt utan den. Vanligt läsande och
# skrivande av uppgifter behöver den inte.
SUPABASE_SERVICE_ROLE_KEY=
